# ============================================
# FRONTEND - VARIABLES DE ENTORNO
# ============================================
# Copiar este archivo como .env.local (desarrollo) o configurar en Dokploy

# --- API BACKEND ---
# URL completa del backend (sin barra final)
# Desarrollo: http://localhost:3080
# Producción: https://x0p.lubenergy.com.ar
NEXT_PUBLIC_API_URL="https://x0p.lubenergy.com.ar"

# --- URL DEL SITIO (SEO) ---
# URL completa del frontend para SEO, sitemap, y OpenGraph
# Desarrollo: http://localhost:3000
# Producción: https://lubenergy.com.ar
NEXT_PUBLIC_SITE_URL="https://lubenergy.com.ar"

# --- ZONA HORARIA (fechas de pedidos en UI; mismo valor que APP_TIMEZONE en el backend) ---
NEXT_PUBLIC_APP_TIMEZONE="America/Argentina/Buenos_Aires"

# ============================================
# CONFIGURACIÓN DE PRODUCCIÓN - LUB ENERGY
# ============================================
# 
# Dominios configurados:
#   - Frontend: https://lubenergy.com.ar
#   - Backend API: https://x0p.lubenergy.com.ar
#
# En Dokploy, configurar estas variables en:
#   App Settings > Environment Variables
#
# IMPORTANTE: 
#   - Las variables NEXT_PUBLIC_ son accesibles en el cliente
#   - Si cambias estas variables, necesitas hacer rebuild
#
# ============================================

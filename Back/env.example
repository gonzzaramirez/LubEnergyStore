# ============================================
# BACKEND - VARIABLES DE ENTORNO
# ============================================
# Copiar este archivo como .env y completar los valores

# --- BASE DE DATOS ---
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Ejemplo local: postgresql://postgres:password@localhost:5432/lubenergystore
# Ejemplo Dokploy: postgresql://postgres:password@postgres:5432/lubenergystore
DATABASE_URL="postgresql://usuario:contraseña@host:5432/lubenergystore"

# --- JWT (SEGURIDAD) ---
# IMPORTANTE: Generar un secreto seguro para producción
# Ejecutar: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="CAMBIAR_POR_UN_SECRETO_SEGURO_DE_64_CARACTERES_MINIMO"

# --- CORS ---
# URL del frontend (sin barra final)
# Desarrollo: http://localhost:3000
# Producción: https://tudominio.com
FRONTEND_URL="https://tudominio.com"

# --- SERVIDOR ---
# Puerto del backend (Dokploy suele usar 3000 interno)
PORT=3080

# --- ENTORNO ---
# development | production
NODE_ENV="production"

# --- INTEGRACIÓN SAAS (cupones por gym) ---
# Clave compartida con el otro servicio que llama POST /integrations/saas/discount-codes
# Mínimo ~16 caracteres; enviar en header X-API-Key o Authorization: Bearer <clave>
SAAS_DISCOUNT_API_KEY="generar_un_secreto_largo_aleatorio"

# --- EMAIL (Resend) ---
# Obtener en: https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxx"
EMAIL_FROM="noreply@tudominio.com"
# Email del admin: recibe aviso al crear cada pedido (el cliente puede cancelar el WhatsApp antes de pagar)
ADMIN_ORDER_EMAIL="admin@tudominio.com"

# --- WHATSAPP (enlaces wa.me en correos; solo dígitos, sin +) ---
WHATSAPP_WA_NUMBER="543795056878"

# --- ZONA HORARIA (fechas en correos y coherencia con el front: usar el mismo valor que NEXT_PUBLIC_APP_TIMEZONE) ---
APP_TIMEZONE="America/Argentina/Buenos_Aires"

# ============================================
# NOTAS PARA DOKPLOY
# ============================================
# 1. En Dokploy, agregar estas variables en:
#    App Settings > Environment Variables
#
# 2. Si usas PostgreSQL de Dokploy:
#    - El host suele ser el nombre del servicio (ej: "postgres")
#    - El puerto interno es 5432
#
# 3. El FRONTEND_URL debe ser el dominio con HTTPS
#    que configuraste en Dokploy para el frontend
#
# 4. NODE_ENV=production activa:
#    - Cookies seguras (secure: true)
#    - Headers de seguridad con Helmet
# ============================================

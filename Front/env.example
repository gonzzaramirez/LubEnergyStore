# ============================================
# FRONTEND - VARIABLES DE ENTORNO
# ============================================
# Copiar este archivo como .env.local (desarrollo) o configurar en Dokploy

# --- API BACKEND ---
# URL completa del backend (sin barra final)
# Desarrollo: http://localhost:3080
# Producción: https://api.tudominio.com
NEXT_PUBLIC_API_URL="https://api.tudominio.com"

# --- URL DEL SITIO (SEO) ---
# URL completa del frontend para SEO, sitemap, y OpenGraph
# Desarrollo: http://localhost:3000
# Test: https://test.farmaciadeturnomc.site
# Producción: https://lubenergy.com.ar
NEXT_PUBLIC_SITE_URL="https://lubenergy.com.ar"

# ============================================
# NOTAS PARA DOKPLOY
# ============================================
# 1. En Dokploy, agregar esta variable en:
#    App Settings > Environment Variables
#
# 2. Opciones de estructura de dominios:
#
#    OPCIÓN A - Subdominio para API:
#    - Frontend: https://tudominio.com
#    - Backend:  https://api.tudominio.com
#    - NEXT_PUBLIC_API_URL="https://api.tudominio.com"
#
#    OPCIÓN B - Mismo dominio con path:
#    - Frontend: https://tudominio.com
#    - Backend:  https://tudominio.com/api (requiere proxy)
#    - NEXT_PUBLIC_API_URL="https://tudominio.com/api"
#
# 3. IMPORTANTE: La variable debe ser NEXT_PUBLIC_
#    para que esté disponible en el cliente
#
# 4. Si cambias esta variable después del build,
#    necesitas hacer rebuild del frontend
# ============================================

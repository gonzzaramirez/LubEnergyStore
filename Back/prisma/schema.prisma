// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- ENUMS ---
// Prisma maneja los enums nativos de Postgres
enum Role {
  ADMIN
  CUSTOMER

  @@map("user_role") // Nombre en base de datos
}

enum OrderStatus {
  PENDING    // Pedido recibido, esperando confirmación de pago
  CONFIRMED  // Pago confirmado por admin
  SHIPPED    // Enviado con código de seguimiento
  CANCELLED  // Cancelado

  @@map("order_status")
}

// --- MODELOS (TABLAS) ---

model User {
  id           String    @id @default(uuid())
  firstName    String    @map("first_name") @db.VarChar(100)
  lastName     String    @map("last_name") @db.VarChar(100)
  email        String    @unique @db.VarChar(255)
  phone        String    @db.VarChar(20)
  passwordHash String?   @map("password_hash")
  googleId     String?   @map("google_id")
  role         Role      @default(CUSTOMER)
  isActive     Boolean   @default(true) @map("is_active")

  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  orders       Order[]

  @@map("users")
}

// Cliente invitado (checkout sin registro)
model GuestCustomer {
  id        String   @id @default(uuid())
  firstName String   @map("first_name") @db.VarChar(100)
  lastName  String   @map("last_name") @db.VarChar(100)
  email     String   @db.VarChar(255)
  phone     String   @db.VarChar(20)
  dni       String   @db.VarChar(15)

  // Dirección de envío
  street     String   @db.VarChar(200) // Calle y número
  apartment  String?  @db.VarChar(50)  // Piso/Depto (opcional)
  city       String   @db.VarChar(100) // Localidad
  province   String   @db.VarChar(100) // Provincia

  createdAt  DateTime @default(now()) @map("created_at")

  orders     Order[]

  @@map("guest_customers")
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(100)
  description String?   @db.Text

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  products    Product[]

  @@map("categories")
}

model Product {
  id            String    @id @default(uuid())
  categoryId    Int?      @map("category_id")
  name          String    @db.VarChar(150)
  slug          String    @unique @db.VarChar(150)
  sku           String    @unique @db.VarChar(50)
  description   String    @db.Text
  price         Int       // Precio en pesos argentinos
  stockQuantity Int       @default(0) @map("stock_quantity")
  imageUrl      String?   @map("image_url")
  isActive      Boolean   @default(true) @map("is_active")
  isFeatured    Boolean   @default(false) @map("is_featured")

  // Promociones por producto
  discountPercent       Int?      @map("discount_percent")        // % de descuento (ej: 20 = 20% off)
  discountStartDate     DateTime? @map("discount_start_date")     // Inicio de la promo
  discountEndDate       DateTime? @map("discount_end_date")       // Fin de la promo

  // Descuento por cantidad (específico del producto)
  minQuantityDiscount       Int?  @map("min_quantity_discount")        // Cantidad mínima (ej: 2)
  quantityDiscountPercent   Int?  @map("quantity_discount_percent")    // % descuento por cantidad

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  category      Category? @relation(fields: [categoryId], references: [id])
  orderItems    OrderItem[]
  priceHistory  PriceHistory[]
  flavors       ProductFlavor[]

  @@map("products")
}

model ProductFlavor {
  id            String   @id @default(uuid())
  productId     String   @map("product_id")
  name          String   @db.VarChar(100) // e.g., "Vainilla", "Chocolate", "Sin Sabor"
  sku           String?  @unique @db.VarChar(50)
  imageUrl      String?  @map("image_url")
  stockQuantity Int      @default(0) @map("stock_quantity")
  isActive      Boolean  @default(true) @map("is_active")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems    OrderItem[]

  @@map("product_flavors")
}

// Historial de cambios de precio
model PriceHistory {
  id            String   @id @default(uuid())
  productId     String   @map("product_id")
  oldPrice      Int      @map("old_price")      // Precio anterior
  newPrice      Int      @map("new_price")      // Precio nuevo
  changePercent Float    @map("change_percent") // % de cambio (positivo = aumento, negativo = baja)
  reason        String   @db.VarChar(200)       // "Aumento masivo 10%", "Edición manual", etc.
  
  createdAt     DateTime @default(now()) @map("created_at")

  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("price_history")
}

// Códigos de descuento (aplican al total del carrito)
model DiscountCode {
  id              String    @id @default(uuid())
  code            String    @unique @db.VarChar(50)  // Código único (ej: "VERANO20")
  description     String?   @db.VarChar(200)         // Descripción interna
  discountPercent Int       @map("discount_percent") // % de descuento
  
  isActive        Boolean   @default(true) @map("is_active")
  validFrom       DateTime? @map("valid_from")       // Fecha inicio validez
  validUntil      DateTime? @map("valid_until")      // Fecha fin validez
  
  usageLimit      Int?      @map("usage_limit")      // Límite de usos (null = ilimitado)
  usageCount      Int       @default(0) @map("usage_count") // Veces usado
  
  minOrderAmount  Int?      @map("min_order_amount") // Monto mínimo de pedido (opcional)

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("discount_codes")
}

model Order {
  id              String      @id @default(uuid())
  userId          String?     @map("user_id")           // Usuario registrado (opcional)
  guestCustomerId String?     @map("guest_customer_id") // Cliente invitado (opcional)
  status          OrderStatus @default(PENDING)
  totalAmount     Int         @map("total_amount")      // Centavos

  // Datos del pedido
  customerNotes   String?     @map("customer_notes") @db.Text // Notas del cliente

  // Datos Logísticos (Admin)
  trackingCode    String?     @map("tracking_code")
  courierName     String?     @map("courier_name") @db.VarChar(100)
  adminNotes      String?     @map("admin_notes") @db.Text

  // Timestamps
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  confirmedAt     DateTime?   @map("confirmed_at")  // Fecha de confirmación de pago
  shippedAt       DateTime?   @map("shipped_at")    // Fecha de envío
  deletedAt       DateTime?   @map("deleted_at")

  // Relaciones
  user            User?          @relation(fields: [userId], references: [id])
  guestCustomer   GuestCustomer? @relation(fields: [guestCustomerId], references: [id])
  items           OrderItem[]

  @@map("orders")
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String  @map("order_id")
  productId   String  @map("product_id")
  flavorId    String? @map("flavor_id")
  quantity    Int
  unitPrice   Int     @map("unit_price")  // Precio congelado al momento de compra
  productName String  @map("product_name") @db.VarChar(150) // Nombre congelado
  flavorName  String? @map("flavor_name") @db.VarChar(100) // Sabor congelado

  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product        @relation(fields: [productId], references: [id])
  flavor      ProductFlavor? @relation(fields: [flavorId], references: [id])

  @@map("order_items")
}